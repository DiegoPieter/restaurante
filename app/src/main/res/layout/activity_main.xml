<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_marginTop="24dp"
        android:contentDescription="Logo del restaurante"
        android:scaleType="fitCenter"
        android:src="@drawable/logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivPastel"
        android:layout_width="150dp"
        android:layout_height="110dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:contentDescription="Pastel de choclo"
        android:scaleType="centerCrop"
        android:src="@drawable/pastel_choclo"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvNombrePastel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="Pastel de Choclo"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/ivPastel"
        app:layout_constraintStart_toEndOf="@id/ivPastel" />

    <TextView
        android:id="@+id/tvCantPastel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cant."
        app:layout_constraintBaseline_toBaselineOf="@id/etCantPastel"
        app:layout_constraintStart_toStartOf="@id/tvNombrePastel" />

    <EditText
        android:id="@+id/etCantPastel"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:hint="0"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/tvNombrePastel"
        app:layout_constraintStart_toEndOf="@id/tvCantPastel" />

    <TextView
        android:id="@+id/tvSubtotalPastel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/etCantPastel"
        app:layout_constraintStart_toStartOf="@id/tvNombrePastel" />

    <ImageView
        android:id="@+id/ivCazuela"
        android:layout_width="150dp"
        android:layout_height="110dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:contentDescription="Cazuela"
        android:scaleType="centerCrop"
        android:src="@drawable/cazuela"
        app:layout_constraintTop_toBottomOf="@id/ivPastel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvNombreCazuela"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="Cazuela"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/ivCazuela"
        app:layout_constraintStart_toEndOf="@id/ivCazuela" />

    <TextView
        android:id="@+id/tvCantCazuela"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cant."
        app:layout_constraintBaseline_toBaselineOf="@id/etCantCazuela"
        app:layout_constraintStart_toStartOf="@id/tvNombreCazuela" />

    <EditText
        android:id="@+id/etCantCazuela"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:hint="0"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/tvNombreCazuela"
        app:layout_constraintStart_toEndOf="@id/tvCantCazuela" />

    <TextView
        android:id="@+id/tvSubtotalCazuela"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/etCantCazuela"
        app:layout_constraintStart_toStartOf="@id/tvNombreCazuela" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guiaTotales"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.45" />

    <TextView
        android:id="@+id/tvTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="32dp"
        android:text="$0"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guiaTotales" />

    <TextView
        android:id="@+id/tvEtiquetaTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="TOTAL"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/tvTotal"
        app:layout_constraintEnd_toStartOf="@id/guiaTotales" />

    <TextView
        android:id="@+id/tvPropina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="12dp"
        android:text="$0"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@id/tvTotal"
        app:layout_constraintStart_toEndOf="@id/guiaTotales" />

    <TextView
        android:id="@+id/tvEtiquetaPropina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="Propina"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/tvPropina"
        app:layout_constraintEnd_toStartOf="@id/guiaTotales" />

    <Switch
        android:id="@+id/swPropina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:checked="true"
        app:layout_constraintTop_toTopOf="@id/tvEtiquetaPropina"
        app:layout_constraintBottom_toBottomOf="@id/tvEtiquetaPropina"
        app:layout_constraintEnd_toStartOf="@id/tvEtiquetaPropina" />

    <TextView
        android:id="@+id/tvComida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="12dp"
        android:text="$0"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@id/tvPropina"
        app:layout_constraintStart_toEndOf="@id/guiaTotales" />

    <TextView
        android:id="@+id/tvEtiquetaComida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="Comida"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/tvComida"
        app:layout_constraintEnd_toStartOf="@id/guiaTotales" />

</androidx.constraintlayout.widget.ConstraintLayout>